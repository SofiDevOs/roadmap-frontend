---
import TabPanel from './TabPanel.astro';
import { TABS } from '../_conts';
const tab = Astro.params.tab || 'account';

---
<div id="panels" class="tab-panels">
    {
    TABS.map(({id, label, ...rest}) => (
        <TabPanel active={tab === label} {id}>
          <rest.component />
        </TabPanel>
    ))
    }
</div>

<style>
#panels {
  width: 100%;
}
</style>

<script is:inline>
  const tabs = document.querySelector('div[role="tablist"]')
  const tabPanels = document.querySelector('.tab-panels')

  tabs.addEventListener("click", handleTabs)

  function handleTabs(event) {
    event.preventDefault()
    const element = event.target

    if(
      element.tagName !== "BUTTON" ||
      element.ariaSelected === "true"
    ) return

    resetButtons()
    resetPanels()

    element.ariaSelected = "true";
    element.tabIndex = 0

    setPathname(element.dataset.name)
    showPanel(element)
  }

  function resetPanels() {
    [...tabPanels?.children].forEach(e => {
      e.hidden = true;
      e.tabIndex = -1;
    })
  }

  function resetButtons() {
    [...tabs?.children].forEach(e => {
      e.tabIndex = -1;
      e.ariaSelected = "false"
    })
  }

  function showPanel(element) {
    const tabNumber = element.getAttribute("aria-controls")
    const panel = tabPanels.querySelector(`#${tabNumber}`)

    if(!panel) return

    panel.hidden = false
    panel.tabIndex = 0
  }

  function setPathname(name) {
    history.pushState(
      {name}, '', `/settings/${name}`
    );
  }

  window.addEventListener("popstate", (event) => {
    event.preventDefault()

    const tab = document.querySelector(
      `[data-name="${event.state?.name || ''}"]`
    )

    if(!tab) history.go();

    resetButtons()
    resetPanels()

    tab.ariaSelected = "true";
    tab.tabIndex = 0

    showPanel(tab);
  });

</script>
