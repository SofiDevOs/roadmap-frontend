---
import CertData from "@shared/data/certificate-data.json";
---

<section class="cert">
  <h2 class="title-primary"> Certificados</h2>
  <div class="cert-grid">
    {
      CertData.map((cert) => (
        <div class="cert-item">
          <div class="img-container">
            <img src={cert.image} alt={cert.title} />
          </div>
        </div>
      ))
    }
  </div>
</section>

<style>
  .cert {
    width: 100%;
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1rem;
  }
  .cert-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 1rem;
  }
    .cert-item {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 1rem;
    }
    .img-container{
        border-radius: 8px;
        width: 100%;
        overflow: hidden;
    }
    .img-container img{
        width: 100%;
        height: auto;
        object-fit: cover;
    }
</style>
