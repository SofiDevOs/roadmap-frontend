---
import BaseHead from "../../layouts/BaseHead.astro";
import "./_style.css"
import "@fontsource/poppins/400.css";
import "@fontsource/poppins/500.css";
import "@fontsource/poppins/600.css";
import "@fontsource/poppins/700.css";
import "@fontsource/poppins/800.css";
import SideBar from "./_components/SideBar.astro";
import ToastAlert from "@components/ToastAlert.astro";
import NavBar from "./_components/NavBar.astro";
import { studentMenu } from "./student/_data/student_menu"
import LayoutHeader from "./_components/LayoutHeader.astro";
import CollapseLeftSidebar from "./_components/CollapseLeftSidebar.astro";

const {
  title,
  description,
  image = "/images/portada.png",
} = Astro.props;
---

<html lang="es">
  <head>
    <BaseHead title={title} description={description} image={image} />
  </head>
  <body>
    <div class="dashboard-layout">
      <SideBar>
        <NavBar menu={studentMenu} slot="navmenu" pathName={Astro.url.pathname} />
      </SideBar>
      <LayoutHeader class="dashboard-header">
        <div class="left-header">
          <CollapseLeftSidebar />
          <slot name="left-header"/>
        </div>
        <div class="right-header">
          <slot name="right-header"/>
        </div>
      </LayoutHeader>
      <main>
        <slot name="above-main"/>
        <div class="wrapper">
          <slot />
        </div>
        <slot name="below-main"/>
        <ToastAlert absolute />
      </main>
    </div>
  </body>
</html>
