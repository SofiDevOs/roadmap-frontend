---
import DeleteButton from "@shared/assets/icons/DeleteButton.astro";
import "./trivia-input.css";
const { radioId, optionId } = Astro.props;
---

<new-option {radioId} {optionId}></new-option>

<script>
  class OptionItemElement extends HTMLElement {
    connectedCallback() {
      const optionId = this.getAttribute("optionId");
      const radioId = this.getAttribute("radioId");
      this.innerHTML = `
      <div class="option-item">
        <fieldset class="option-container">
          <label for='${radioId}' class="radio-btn-label">
            <span class="radio-btn-icon" style="pointer-events: none;"></span>
            <input
              data-textarea='${optionId}'
              class="radio-btn"
              type="radio"
              id='${radioId}'
              name="correct-answer"
              hidden
              value='${optionId}'
            />
          </label>
          <div class="option-input-container">
            <input
              class="option-input"
              type="text"
              id='${optionId}'
              name="options"
              placeholder="Ingresa tu respuesta"
              maxlength="80"
              required
              onkeyup="this.parentElement.querySelector('.character-counter').innerText = this.value.length + '/80'"
            />
            <span class="character-counter"></span>
          </div>
          <button onclick="this.parentElement.parentElement.remove()" type="button" class="delete-btn" aria-label="Eliminar opción">
            <svg
              width="16"
              heigth="16"
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 448 512"
            >
              <path
                fill="currentColor"
                d="M135.2 17.7L128 32H32C14.3 32 0 46.3 0 64s14.3 32 32 32h384c17.7 0 32-14.3 32-32s-14.3-32-32-32h-96l-7.2-14.3C307.4 6.8 296.3 0 284.2 0H163.8c-12.1 0-23.2 6.8-28.6 17.7M416 128H32l21.2 339c1.6 25.3 22.6 45 47.9 45h245.8c25.3 0 46.3-19.7 47.9-45z"
              ></path>
            </svg>
          </button>
        </fieldset>

        <div class="option-input-container explanation-container">
          <span class="character-counter"></span>
          <textarea
            hidden
            class="explanation"
            name="explanation"
            data-id='${optionId}'
            maxlength="500"
            placeholder="Explica por qué esta opción es correcta (Opcional)"
            onkeyup="this.parentElement.querySelector('.character-counter').innerText = this.value.length + '/500'"
          ></textarea>
        </div>
      </div>
      `;
    }
  }
  customElements.define("new-option", OptionItemElement);
</script>
