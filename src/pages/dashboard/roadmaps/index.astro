---
import TableAdmin from "../_components/TableAdmin.astro";
import Layout from "../_Layout.astro";
import { getRoadmaps } from "@shared/services/roadmap.service";

const cookies = Astro.cookies;
const accessToken = cookies.get("access_token")?.value || null;

const roadmaps = await getRoadmaps(accessToken as string); 
---

<Layout>
  <section class="roadmaps">
    <h2 class="title-secundary action-title">Roadmaps</h2>
    <TableAdmin data={roadmaps ?? []} resource="roadmaps" />
  </section>
</Layout>
