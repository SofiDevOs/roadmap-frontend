---
import DashboardTable from "../_components/DashboardTable.astro";
import CourseTableBody from "./_components/CoursesTableBody.astro";
import Layout from "../_Layout.astro";
import { api } from "src/consts";
import type { Course } from "../_types/course.type";

const cookies = Astro.cookies;
const accessToken = cookies.get("access_token");

const [courses] = await api("courses")()<Course[]>({
  method: "GET",
  headers: {
    authorization: `Bearer ${accessToken?.value}`,
  },
});
const headTable = ["ID", "Título", "Descripción", "Editar", "Eliminar"];
---

<Layout buttonContent="Agregar Curso" buttonUrl="/dashboard/cursos/create" >
  <section class="roadmaps">
    <h2 class="title-secundary action-title">Cursos</h2>
    <DashboardTable thead={headTable}>
      <slot>
        <CourseTableBody courses={courses} /> 
      </slot>
    </DashboardTable>
  </section>
</Layout>
