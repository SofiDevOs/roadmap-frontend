---
import data from "@shared/data/roadmap.mock.json";
import RoadmapCard from "./components/roadmap-card/RoadmapCard.astro";
---

<section class="roadmaps">
  <h2 class="title-secundary roadmap-title">Roadmaps</h2>
  <div class="roadmap-container">
    {data.map((roadmap) => <RoadmapCard {...roadmap} />)}
  </div>
</section>

<style>
  .roadmaps {
    display: flex;
    flex-direction: column;
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    padding: 2rem;
  }

  .roadmap-title {
    text-align: left;
    font-size: clamp(2.8rem, 6vw, 4rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    margin-bottom: clamp(3rem, 6vw, 5rem);
    line-height: 1.1;
  }

  .roadmap-container {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  @media (width < 940px) {
    .roadmaps {
      padding: 1.5rem 1rem;
    }

    .roadmap-title {
      text-align: center;
    }

    .roadmap-container {
      gap: 1.5rem;
    }
  }

  @media (width < 480px) {
    .roadmaps {
      padding: 1rem 0.75rem;
    }
  }
</style>
